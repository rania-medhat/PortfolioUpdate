# Example environment variables for Node Backend
# Copy to .env and update values before running locally or deploying
PORT=8000
# Production: 127.0.0.1 (Nginx proxies to it). Leave unset for local development.
# HOST=127.0.0.1
NODE_ENV=development

# Required in production, e.g. mongodb+srv://username:password@cluster.mongodb.net/portfolio
# (local fallback only applies when NODE_ENV is not production)
MONGO_URI=mongodb://localhost:27017/portfolio

# Cloudinary (Dashboard → API Keys). Backend only — never expose the secret to Angular.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend origin allowed by CORS; comma-separated for several (the admin session cookie needs an explicit origin).
# In production use your real site, e.g. https://example.com. localhost is allowed automatically outside production.
CLIENT_ORIGIN=http://localhost:4200

# Admin session cookie SameSite: lax (frontend and API on the same root domain, e.g. portfolio.example.com + api.example.com)
# or none (cross-site, e.g. https://x.vercel.app + an unrelated API domain; forces Secure).
COOKIE_SAME_SITE=lax

# Google OAuth Web client ID (Google Cloud Console → Credentials).
# Add http://localhost:4200 and http://localhost to its "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Only this verified Google account can access the dashboard
ADMIN_EMAIL=your_admin_email@example.com

# Random string, at least 32 characters, used to sign the admin session cookie
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
