{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/portfolio-frontend/browser",
  "rewrites": [
    { "source": "/((?!.*\.[a-zA-Z0-9]+$).*)", "destination": "/index.html" }
  ]
}
